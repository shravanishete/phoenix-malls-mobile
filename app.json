{
  "expo": {
    "name": "phoenix-malls-mobile",
    "slug": "phoenix-malls-mobile",
    "scheme": "phoenixmalls",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.phoenixmalls.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@maplibre/maplibre-react-native",
       [
    "expo-location",
    {
      "locationWhenInUsePermission": "Allow Phoenix Malls to use your location to find the nearest mall."
    }
  ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e2d937b5-d7b7-4208-b4a5-17eb630d0d88"
      }
    }
  }
}
